{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyNamedLearningBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_LEARNING_BUCKET"
    },
    {
      "Sid": "ReadObjectsOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_LEARNING_BUCKET/*"
    },
    {
      "Sid": "RequireTLS",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::REPLACE_WITH_LEARNING_BUCKET",
        "arn:aws:s3:::REPLACE_WITH_LEARNING_BUCKET/*"
      ],
      "Condition": {"Bool": {"aws:SecureTransport": "false"}}
    }
  ]
}

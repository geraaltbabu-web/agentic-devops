# Copy to .env locally. Never commit real keys.

# Optional OpenAI-compatible endpoint. If unset, the agent uses the local planner.
AGENT_LLM_BASE_URL=https://api.openai.com/v1
AGENT_LLM_MODEL=gpt-4o-mini
AGENT_LLM_API_KEY=

# Deploy safety
AGENT_APPLY=false
APPROVE_PROD=false
AGENT_ENV=dev

# Simulated cluster (default). Set to 0 to require a real kubeconfig.
AGENT_SIMULATE=1
